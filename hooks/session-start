#!/usr/bin/env bash
# SessionStart hook for the brainstorm plugin.
# Injects the using-brainstorm skill so the workflow rules are in context from turn one.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

skill_content=$(cat "${PLUGIN_ROOT}/skills/using-brainstorm/SKILL.md" 2>/dev/null || echo "Error reading using-brainstorm skill")

# Escape for JSON embedding. Each substitution is one C-level pass.
escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

skill_escaped=$(escape_for_json "$skill_content")
context="<IMPORTANT>\nThis project may use the brainstorm delivery workflow. If a brainstorm/status.json file exists in the project, follow the workflow below for all delivery work; ignore it otherwise.\n\nFull content of the 'brainstorm:using-brainstorm' skill:\n\n${skill_escaped}\n</IMPORTANT>"

printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$context"

exit 0
